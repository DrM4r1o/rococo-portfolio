---
import { getCollection } from 'astro:content';

const featuredIds = ['aemet-weather', 'branch-radar-engine', 'netura'];

const collection = await getCollection('projects', ({ id }) => featuredIds.includes(id));
const entries = featuredIds
	.map((id) => collection.find((project) => project.id === id))
	.filter((project): project is (typeof collection)[number] => Boolean(project));

const numerals = ['I', 'II', 'III', 'IV', 'V'];
---

<section
	id="artesania-voyage"
	class="fixed inset-0 z-40 flex flex-col"
	aria-hidden="true"
	inert
	aria-label="Sur — Artesanía y vitrina de obras"
>
	<div class="artesania-backdrop pointer-events-none absolute inset-0"></div>

	<header class="relative z-10 shrink-0 px-6 pt-8 pb-4 md:px-16 md:pt-12">
		<div class="mx-auto w-full max-w-5xl">
			<div class="artesania-item flex items-center gap-3 font-cinzel text-[10px] tracking-[0.35em] text-bronze uppercase">
				<span class="h-px w-12 bg-gradient-to-r from-transparent via-bronze to-transparent"></span>
				<span>Coordenada Meridional · 180°</span>
				<span class="h-px w-12 bg-gradient-to-l from-transparent via-bronze to-transparent"></span>
			</div>
			<h2 class="artesania-item gold-leaf-text mt-4 font-cinzel text-3xl tracking-[0.08em] uppercase sm:text-4xl md:text-5xl">
				Sur — Artesanía &amp; Obras
			</h2>
			<p class="artesania-item mt-3 max-w-2xl font-cormorant text-lg leading-relaxed text-on-surface-variant italic md:text-xl">
				Tres piezas seleccionadas de ingeniería full-stack: del core bancario y el ERP a la herramienta de escritorio
				asistida por IA. El resto del catálogo aguarda en la coordenada oriental.
			</p>
		</div>
	</header>

	<div class="artesania-scroll relative z-10 flex-1 overflow-y-auto px-6 pt-6 pb-32 md:px-16">
		{
			entries.length > 0 ? (
				<ol class="mx-auto w-full max-w-5xl grid gap-5 md:grid-cols-3">
					{entries.map((entry, index) => (
						<li class="artesania-item">
							<a
								href={`/projects/${entry.id}/`}
								class="group flex h-full flex-col rounded-sm border border-outline-variant/40 bg-[#fcfaf6]/5 p-6 transition-colors hover:border-bronze/50 hover:bg-bronze/10"
							>
								<div class="flex items-center justify-between font-cinzel text-[10px] tracking-[0.3em] text-bronze uppercase">
									<span class="text-bronze-light">{numerals[index] ?? index + 1}</span>
									<span>{entry.data.year}</span>
								</div>
								<h3 class="mt-4 font-garamond text-2xl text-on-surface transition-colors group-hover:text-bronze-light">
									{entry.data.title}
								</h3>
								<p class="mt-1 font-cinzel text-[10px] tracking-[0.2em] text-bronze uppercase">{entry.data.role}</p>
								<p class="mt-3 flex-1 font-body text-sm leading-relaxed text-on-surface-variant">
									{entry.data.description}
								</p>
								<ul class="mt-5 flex flex-wrap gap-2">
									{entry.data.stack.slice(0, 4).map((tech) => (
										<li class="rounded-sm border border-outline-variant/50 bg-bronze/10 px-2 py-0.5 text-[10px] tracking-[0.12em] text-bronze uppercase">
											{tech}
										</li>
									))}
								</ul>
								<span class="mt-6 flex items-center gap-2 font-cinzel text-[10px] tracking-[0.28em] text-bronze uppercase transition-colors group-hover:text-bronze-light">
									<span>Ver la pieza</span>
									<span class="material-symbols-outlined text-[15px] transition-transform group-hover:translate-x-1">
										arrow_forward
									</span>
								</span>
							</a>
						</li>
					))}
				</ol>
			) : (
				<p class="artesania-item mx-auto w-full max-w-5xl font-cormorant text-lg text-on-surface-variant italic">
					Las piezas de esta vitrina aún se están catalogando.
				</p>
			)
		}

		<div class="artesania-item mx-auto mt-8 flex w-full max-w-5xl justify-center">
			<a
				href="/projects"
				class="flex items-center gap-2 rounded-full border border-bronze/50 bg-bronze/10 px-6 py-2.5 font-cinzel text-[10px] tracking-[0.28em] text-bronze uppercase transition-colors hover:border-bronze hover:text-bronze-light focus:outline-none focus-visible:ring-2 focus-visible:ring-bronze"
			>
				<span>Ver todas las obras</span>
				<span class="material-symbols-outlined text-[16px]">arrow_forward</span>
			</a>
		</div>
	</div>

	<div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 flex justify-center pb-6 md:pb-8">
		<button
			id="artesania-return"
			type="button"
			class="artesania-return pointer-events-auto flex cursor-pointer items-center gap-2 rounded-full border border-bronze/50 bg-primary-darkest/85 px-6 py-2.5 font-cinzel text-[10px] tracking-[0.28em] text-bronze uppercase shadow-[0_8px_24px_rgba(0,0,0,0.55)] backdrop-blur-md transition-colors hover:border-bronze hover:text-bronze-light focus:outline-none focus-visible:ring-2 focus-visible:ring-bronze"
		>
			<span class="material-symbols-outlined text-[16px]">explore</span>
			<span>Volver a la brújula</span>
		</button>
	</div>
</section>

<style>
	.artesania-backdrop {
		background:
			radial-gradient(ellipse at 50% 60%, rgba(42, 78, 66, 0.92) 0%, rgba(28, 54, 45, 0.95) 55%, rgba(18, 34, 27, 0.97) 100%),
			radial-gradient(circle at 85% 15%, rgba(68, 114, 99, 0.25) 0%, transparent 45%),
			radial-gradient(ellipse at 50% 10%, rgba(197, 168, 105, 0.08) 0%, transparent 60%);
	}
</style>

<script>
	import { initArtesaniaVoyage } from '../../scripts/artesania-voyage';

	let cleanup: (() => void) | null = null;

	const boot = () => {
		if (!document.getElementById('artesania-voyage')) return;
		cleanup = initArtesaniaVoyage();
	};

	const teardown = () => {
		cleanup?.();
		cleanup = null;
	};

	document.addEventListener('astro:page-load', boot);
	document.addEventListener('astro:before-swap', teardown);
</script>
