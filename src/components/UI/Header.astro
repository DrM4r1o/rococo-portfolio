---
const links = [
	{ label: 'Brújula', href: '/', active: true },
	{ label: 'Obras', href: '/projects', active: false },
	{ label: 'Crónicas', href: '/blog', active: false },
	{ label: 'Taller', href: '#', active: false },
];
---

<header
	transition:persist
	class="theatrical-trans theatrical-target group pointer-events-none fixed inset-x-0 top-0 z-50 opacity-60 hover:opacity-100"
>
	<div class="pointer-events-auto grid h-16 w-full grid-cols-[1fr_auto_1fr] items-center px-6 md:px-12">
		<a
			href="/"
			aria-label="Volver a la brújula"
			class="flex items-center gap-3 justify-self-start transition-opacity hover:opacity-90"
		>
			<span class="material-symbols-outlined text-[19px] font-light text-bronze">explore</span>
			<div class="flex flex-col">
				<span class="font-cinzel text-[11px] tracking-[0.28em] text-[#faf5eb]/90 uppercase"
					>La Brújula Rococó</span
				>
				<span class="font-cormorant text-[11px] tracking-wider text-bronze italic"
					>Instrumentarium Curatorial</span
				>
			</div>
		</a>

		<nav
			class="col-start-2 hidden items-center gap-7 justify-self-center font-cinzel text-[11px] tracking-[0.22em] uppercase md:flex"
		>
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={[
							'transition-colors',
							link.active ? 'font-medium text-bronze' : 'text-[#faf5ea]/65 hover:text-bronze',
						]}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div
			class="col-start-3 flex items-center gap-3 justify-self-end font-cinzel text-[10px] tracking-widest text-[#faf5ea]/70"
		>
			<button
				id="perspective-toggle"
				type="button"
				class="flex cursor-pointer items-center gap-1.5 px-2 py-1 transition-colors hover:text-bronze"
				aria-label="Alternar perspectiva de la brújula"
			>
				<span class="material-symbols-outlined text-[15px]" id="persp-icon">filter_center_focus</span>
				<span class="hidden sm:inline" id="persp-text">Cenital</span>
			</button>
		</div>
	</div>
</header>
