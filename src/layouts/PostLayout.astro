---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
	eyebrow?: string;
	backHref?: string;
	backLabel?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	eyebrow = 'Chronicle',
	backHref = '/',
	backLabel = 'Volver a la brújula',
} = Astro.props;

const dateFmt = new Intl.DateTimeFormat('es-ES', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<BaseLayout title={`${title} — La Brújula Rococó`} description={description}>
	<div class="relative z-10 mx-auto flex min-h-screen max-w-3xl flex-col px-6 py-16 md:px-10 md:py-24">
		<a
			href={backHref}
			class="group mb-12 inline-flex items-center gap-2 font-cinzel text-[11px] tracking-[0.25em] text-bronze uppercase transition-colors hover:text-bronze-light"
		>
			<span class="material-symbols-outlined text-[15px] transition-transform group-hover:-translate-x-1"
				>arrow_back</span
			>
			{backLabel}
		</a>

		<header class="border-b border-bronze/25 pb-8">
			<div class="flex items-center gap-3 text-[10px] tracking-[0.3em] text-bronze uppercase">
				<span class="font-cinzel">{eyebrow}</span>
				{
					pubDate && (
						<>
							<span class="h-px w-8 bg-bronze/40" />
							<time datetime={pubDate.toISOString()}>{dateFmt.format(pubDate)}</time>
						</>
					)
				}
			</div>
			<h1 class="gold-leaf-text mt-4 font-cinzel text-3xl tracking-wide md:text-4xl">{title}</h1>
			{description && <p class="mt-3 font-cormorant text-lg italic text-on-surface-variant">{description}</p>}
			{
				updatedDate && (
					<p class="mt-2 text-[11px] tracking-widest text-on-surface-variant/60 uppercase">
						Actualizado el {dateFmt.format(updatedDate)}
					</p>
				)
			}
			{
				tags.length > 0 && (
					<ul class="mt-5 flex flex-wrap gap-2">
						{tags.map((tag) => (
							<li class="rounded-sm border border-outline-variant/60 bg-bronze/10 px-2.5 py-1 text-[10px] tracking-[0.15em] text-bronze uppercase">
								{tag}
							</li>
						))}
					</ul>
				)
			}
		</header>

		<article class="prose-rococo mt-10">
			<slot />
		</article>

		<footer class="mt-16 border-t border-bronze/25 pt-6">
			<a
				href={backHref}
				class="font-cinzel text-[11px] tracking-[0.25em] text-bronze uppercase transition-colors hover:text-bronze-light"
			>
				{backLabel}
			</a>
		</footer>
	</div>
</BaseLayout>
