---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/UI/Header.astro";
import FooterAccordion from "../../components/UI/FooterAccordion.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Crónicas — La Brújula Rococó"
  description="Bitácora técnica y ensayos sobre diseño de instrumentos digitales."
>
  <Header />

  <main
    class="relative z-10 mx-auto w-full max-w-5xl px-6 pt-32 pb-40 md:px-10"
  >
    <header class="border-b border-bronze/25 pb-8">
      <span
        class="font-cinzel text-[10px] tracking-[0.35em] text-bronze uppercase"
        >Coordenada Oeste · 270°</span
      >
      <h1
        class="gold-leaf-text mt-3 font-cinzel text-4xl tracking-wide md:text-5xl"
      >
        Crónicas
      </h1>
      <p
        class="mt-3 max-w-2xl font-cormorant text-lg italic text-on-surface-variant"
      >
        Bitácora técnica, ensayos de oficio y notas de taller.
      </p>
    </header>

    <ul class="mt-10 space-y-4">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}/`}
              class="group block rounded-sm border border-outline-variant/40 bg-[#fcfaf6]/5 p-6 transition-colors hover:border-bronze/50 hover:bg-bronze/10"
            >
              <div class="flex items-center gap-3 font-cinzel text-[10px] tracking-[0.25em] text-bronze uppercase">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFmt.format(post.data.pubDate)}
                </time>
                <span class="h-px w-6 bg-bronze/40" />
                <span>{post.data.tags.join(" · ")}</span>
              </div>
              <h2 class="mt-3 font-garamond text-2xl text-on-surface transition-colors group-hover:text-bronze-light">
                {post.data.title}
              </h2>
              <p class="mt-2 font-body text-sm leading-relaxed text-on-surface-variant">
                {post.data.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>

    {
      posts.length === 0 && (
        <p class="mt-10 font-cormorant italic text-on-surface-variant">
          Sin crónicas aún.
        </p>
      )
    }
  </main>

  <FooterAccordion />
</BaseLayout>
