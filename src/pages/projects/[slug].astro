---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

type Props = { entry: CollectionEntry<'projects'> };
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const { year, role, stack, url, repo, links } = entry.data;

const relatedLinks = [
	...links,
	...(url ? [{ label: 'Sitio', href: url }] : []),
	...(repo ? [{ label: 'Código', href: repo }] : []),
];
---

<PostLayout
	title={entry.data.title}
	description={entry.data.description}
	pubDate={entry.data.pubDate}
	tags={stack}
	eyebrow={`Exhibit · ${year}`}
	backHref="/projects"
	backLabel="Volver a Obras"
>
	<dl class="mb-8 grid grid-cols-2 gap-4 border border-outline-variant/40 bg-[#fcfaf6]/5 p-4 text-sm sm:grid-cols-4">
		<div>
			<dt class="font-cinzel text-[10px] tracking-[0.2em] text-bronze uppercase">Año</dt>
			<dd class="mt-1 text-on-surface">{year}</dd>
		</div>
		<div>
			<dt class="font-cinzel text-[10px] tracking-[0.2em] text-bronze uppercase">Rol</dt>
			<dd class="mt-1 text-on-surface">{role}</dd>
		</div>
		<div>
			<dt class="font-cinzel text-[10px] tracking-[0.2em] text-bronze uppercase">Stack</dt>
			<dd class="mt-1 text-on-surface">{stack.join(', ')}</dd>
		</div>
		<div>
			<dt class="font-cinzel text-[10px] tracking-[0.2em] text-bronze uppercase">Enlaces</dt>
			<dd class="mt-1 flex flex-col gap-1.5">
				{
					relatedLinks.length > 0 ? (
						relatedLinks.map((link) => (
							<a
								href={link.href}
								target="_blank"
								rel="noreferrer"
								class="group inline-flex items-center gap-1.5 font-body text-sm text-on-surface transition-colors hover:text-bronze-light"
							>
								<span class="material-symbols-outlined text-[15px] text-bronze">link</span>
								<span class="underline decoration-bronze/30 underline-offset-4 transition-colors group-hover:decoration-bronze">
									{link.label}
								</span>
								<span class="material-symbols-outlined text-[13px] text-bronze opacity-0 transition-opacity group-hover:opacity-100">
									open_in_new
								</span>
							</a>
						))
					) : (
						<span class="text-on-surface-variant/60">—</span>
					)
				}
			</dd>
		</div>
	</dl>

	<Content />
</PostLayout>
